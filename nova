function SectionMethods:AddKeybind(config)
	config = config or {}
	local theme = self.Window.Theme
	local callback = config.Callback or function() end
	local currentKey = config.Default or Enum.KeyCode.Unknown
	local listening = false

	local row = buildRow(self, {
		Name = config.Name,
		Description = config.Description,
		ControlWidth = 90,
	})

	local box = new("TextButton", {
		Name = "KeybindBox",
		Size = UDim2.fromOffset(80, 26),
		Position = UDim2.new(1, -80, 0.5, -13),
		BackgroundColor3 = theme.ElevatedHover,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	corner(6).Parent = box
	stroke(theme.StrokeSoft, 1).Parent = box

	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Text = currentKey ~= Enum.KeyCode.Unknown and currentKey.Name or "...",
		TextColor3 = theme.Text,
		TextSize = 12,
		FontFace = Fonts.Medium,
		Parent = box,
	})

	box.MouseButton1Click:Connect(function()
		listening = true
		label.Text = "..."
		tween(box, { BackgroundColor3 = theme.Accent }, 0.1)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			currentKey = input.KeyCode
			label.Text = currentKey.Name
			listening = false
			tween(box, { BackgroundColor3 = theme.ElevatedHover }, 0.1)
			callback(currentKey)
		elseif not processed and input.KeyCode == currentKey then
			callback(currentKey)
		end
	end)

	return {
		Set = function(_, key) currentKey = key; label.Text = key.Name end,
		Get = function() return currentKey end,
	}
end


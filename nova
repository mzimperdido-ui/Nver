			TextColor3 = theme.TextMuted,
			TextSize = 11,
			FontFace = Fonts.Regular,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Parent = textHolder,
		})
	end

	return row, textHolder
end


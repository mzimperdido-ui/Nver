	Icons.Apply(icon, iconName)

	local label = new("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -36, 1, 0),
		Position = UDim2.new(0, 33, 0, 0),
		Text = name,
		TextColor3 = theme.TextDim,
		TextSize = 12.5,
		FontFace = Fonts.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = tabButton,
	})

	local page = new("ScrollingFrame", {
		Name = name .. "_Page",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Stroke,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = self.ContentArea,
	})
	padding(14).Parent = page
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page,
	})

	local Tab = setmetatable({
		Name = name,
		Window = self,
		Button = tabButton,
		Page = page,
	}, TabPrototype)

	table.insert(self.Tabs, Tab)
	table.insert(self._tabButtons, tabButton)

	local function setActive(activeTab)
		for _, t in ipairs(self.Tabs) do
			local isActive = (t == activeTab)
			t.Page.Visible = isActive
			local btnIcon = t.Button:FindFirstChild("Icon")
			local btnLabel = t.Button:FindFirstChild("Label")
			local btnBar = t.Button:FindFirstChild("ActiveBar")
			tween(t.Button, { BackgroundTransparency = isActive and 0 or 1 }, 0.15)
			tween(btnIcon, { ImageColor3 = isActive and theme.Text or theme.TextDim }, 0.15)
			tween(btnLabel, { TextColor3 = isActive and theme.Text or theme.TextDim }, 0.15)
			tween(btnBar, { BackgroundTransparency = isActive and 0 or 1 }, 0.15)
		end
		self._activeTab = activeTab
	end

	tabButton.MouseButton1Click:Connect(function()
		setActive(Tab)
	end)
	tabButton.MouseEnter:Connect(function()
		if self._activeTab ~= Tab then
			tween(tabButton, { BackgroundTransparency = 0.6 }, 0.12)
		end
	end)
	tabButton.MouseLeave:Connect(function()
		if self._activeTab ~= Tab then
			tween(tabButton, { BackgroundTransparency = 1 }, 0.12)
		end
	end)

	if #self.Tabs == 1 then
		setActive(Tab)
	end

	return Tab
end


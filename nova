function NovaUI:Notify(config)
	config = config or {}
	local theme = self.Theme

	local duration = config.Duration or 4

	local accentColor = theme.Accent
	local iconName = config.Icon or "info"
	if config.Type == "success" then
		accentColor = theme.Success
		iconName = config.Icon or "circle-check"
	elseif config.Type == "warning" then
		accentColor = theme.Warning
		iconName = config.Icon or "triangle-alert"
	elseif config.Type == "error" then
		accentColor = theme.Danger
		iconName = config.Icon or "circle-x"
	end

	local card = new("Frame", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, 40),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Elevated,
		BackgroundTransparency = 1,
		Parent = self.NotifHolder,
	})
	corner(9).Parent = card
	stroke(theme.Stroke, 1).Parent = card
	padding(12).Parent = card

	local accentBar = new("Frame", {
		Size = UDim2.new(0, 3, 1, -8),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = accentColor,
		BackgroundTransparency = 1,
		Parent = card,
	})
	corner(2).Parent = accentBar

	local icon = new("ImageLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.new(0, 0, 0, 0),
		ImageColor3 = accentColor,
		ImageTransparency = 1,
		Parent = card,
	})
	Icons.Apply(icon, iconName)

	local titleLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -26, 0, 16),
		Position = UDim2.new(0, 26, 0, 0),
		Text = config.Title or "Notificação",
		TextColor3 = theme.Text,
		TextTransparency = 1,
		TextSize = 13,
		FontFace = Fonts.SemiBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})

	local contentLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -26, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(0, 26, 0, 18),
		Text = config.Content or "",
		TextColor3 = theme.TextMuted,
		TextTransparency = 1,
		TextSize = 11.5,
		FontFace = Fonts.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Parent = card,
	})

	tween(card, { BackgroundTransparency = 0 }, 0.2)
	tween(accentBar, { BackgroundTransparency = 0 }, 0.2)
	tween(icon, { ImageTransparency = 0 }, 0.2)
	tween(titleLabel, { TextTransparency = 0 }, 0.2)
	tween(contentLabel, { TextTransparency = 0 }, 0.2)

	task.delay(duration, function()
		if not card or not card.Parent then return end
		local fadeOut = tween(card, { BackgroundTransparency = 1 }, 0.25)
		tween(accentBar, { BackgroundTransparency = 1 }, 0.25)
		tween(icon, { ImageTransparency = 1 }, 0.25)
		tween(titleLabel, { TextTransparency = 1 }, 0.25)
		tween(contentLabel, { TextTransparency = 1 }, 0.25)
		fadeOut.Completed:Wait()
		card:Destroy()
	end)

	return card
end

return NovaUI

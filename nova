function NovaUI:_bindToggleKey()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == self.ToggleKey then
			self:Toggle()
		end
	end)
end

function NovaUI:_buildMobileFab()
	local theme = self.Theme
	local fab = new("ImageButton", {
		Name = "MobileFab",
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.fromOffset(16, 100),
		BackgroundColor3 = theme.Elevated,
		AutoButtonColor = false,
		Parent = self.ScreenGui,
	})
	corner(23).Parent = fab
	stroke(theme.Stroke, 1).Parent = fab

	local icon = new("ImageLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(0.5, -10, 0.5, -10),
		ImageColor3 = theme.Text,
		Parent = fab,
	})
	Icons.Apply(icon, "sliders-horizontal")

	fab.MouseButton1Click:Connect(function()
		self:Toggle()
	end)

	local dragging, dragStart, startPos = false, nil, nil
	fab.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = fab.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
			local delta = input.Position - dragStart
			fab.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	self.MobileFab = fab
end

function NovaUI:Toggle(force)
	local visible = force
	if visible == nil then
		visible = not self.Main.Visible
	end
	self.Main.Visible = visible
end


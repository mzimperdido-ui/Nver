function SectionMethods:AddToggle(config)
	config = config or {}
	local theme = self.Window.Theme
	local state = config.Default or false
	local callback = config.Callback or function() end

	local row = buildRow(self, {
		Name = config.Name,
		Description = config.Description,
		ControlWidth = 40,
	})

	local track = new("Frame", {
		Name = "Track",
		Size = UDim2.fromOffset(36, 20),
		Position = UDim2.new(1, -36, 0.5, -10),
		BackgroundColor3 = state and theme.Accent or theme.ToggleOff,
		Parent = row,
	})
	corner(10).Parent = track

	local thumb = new("Frame", {
		Name = "Thumb",
		Size = UDim2.fromOffset(16, 16),
		Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Parent = track,
	})
	corner(8).Parent = thumb

	local clickCatcher = new("TextButton", {
		Name = "ClickCatcher",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Text = "",
		Parent = row,
	})

	local function setState(newState, fire)
		state = newState
		tween(track, { BackgroundColor3 = state and theme.Accent or theme.ToggleOff }, 0.15)
		tween(thumb, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) }, 0.15, Enum.EasingStyle.Quad)
		if fire ~= false then
			callback(state)
		end
	end

	clickCatcher.MouseButton1Click:Connect(function()
		setState(not state)
	end)

	if state then
		callback(state)
	end

	return {
		Set = function(_, v) setState(v) end,
		Get = function() return state end,
	}
end

function SectionMethods:AddSlider(config)
	config = config or {}
	local theme = self.Window.Theme
	local min = config.Min or 0
	local max = config.Max or 100
	local default = math.clamp(config.Default or min, min, max)
	local suffix = config.Suffix or ""
	local callback = config.Callback or function() end
	local value = default

	local hasDescription = config.Description ~= nil and config.Description ~= ""
	local topHeight = hasDescription and 34 or 18

	local container = new("Frame", {
		Name = "SliderContainer",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, topHeight + 22),
		LayoutOrder = self._order,
		Parent = self.Frame,
	})
	self._order += 1

	new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -50, 0, 16),
		Text = config.Name or "",
		TextColor3 = theme.Text,
		TextSize = 13,
		FontFace = Fonts.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = container,
	})

	local valueLabel = new("TextLabel", {
		Name = "ValueLabel",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 50, 0, 16),
		Position = UDim2.new(1, -50, 0, 0),
		Text = tostring(value) .. suffix,
		TextColor3 = theme.TextMuted,
		TextSize = 12,
		FontFace = Fonts.Medium,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = container,
	})

	if hasDescription then
		new("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 14),
			Position = UDim2.new(0, 0, 0, 18),
			Text = config.Description,
			TextColor3 = theme.TextMuted,
			TextSize = 11,
			FontFace = Fonts.Regular,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = container,
		})
	end

	local track = new("Frame", {
		Name = "Track",
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0, topHeight + 8),
		BackgroundColor3 = theme.ToggleOff,
		Parent = container,
	})
	corner(3).Parent = track

	local hitArea = new("Frame", {
		Name = "HitArea",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 0, topHeight + 8 - 9),
		Parent = container,
	})

	local fill = new("Frame", {
		Name = "Fill",
		Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = theme.Accent,
		Parent = track,
	})
	corner(3).Parent = fill

	local grabber = new("Frame", {
		Name = "Grabber",
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Parent = track,
	})
	corner(7).Parent = grabber
	stroke(theme.Stroke, 1).Parent = grabber

	local dragging = false

	local function setFromAlpha(alpha)
		alpha = math.clamp(alpha, 0, 1)
		value = math.floor(min + (max - min) * alpha + 0.5)
		local realAlpha = (value - min) / (max - min)
		fill.Size = UDim2.new(realAlpha, 0, 1, 0)
		grabber.Position = UDim2.new(realAlpha, 0, 0.5, 0)
		valueLabel.Text = tostring(value) .. suffix
		callback(value)
	end

	local function beginDrag(input)
		dragging = true
	end

	local function updateDrag(input)
		if not dragging then return end
		local relativeX = input.Position.X - track.AbsolutePosition.X
		setFromAlpha(relativeX / track.AbsoluteSize.X)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			beginDrag(input)
			updateDrag(input)
		end
	end)
	hitArea.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			beginDrag(input)
			updateDrag(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			updateDrag(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return {
		Set = function(_, v) setFromAlpha((v - min) / (max - min)) end,
		Get = function() return value end,
	}
end


	local textHolder = new("Frame", {
		Name = "TextHolder",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -(opts.ControlWidth or 46), 1, 0),
		Position = UDim2.new(0, 0, 0, 0),

function NovaUI.new(config)
	config = config or {}

	local self = setmetatable({}, NovaUI)

	self.Title = config.Title or "Nova UI"
	self.Subtitle = config.Subtitle or nil
	self.ThemeName = config.Theme or "Dark"
	self.Theme = Themes[self.ThemeName] or Themes.Dark
	self.ToggleKey = config.ToggleKey or Enum.KeyCode.RightControl
	self.Size = config.Size or (IS_MOBILE and UDim2.fromOffset(360, 480) or UDim2.fromOffset(560, 400))

	self.Tabs = {}
	self._tabButtons = {}
	self._activeTab = nil

	self:_buildScreenGui()
	self:_buildWindow()
	self:_buildTopBar()
	self:_buildSidebar()
	self:_buildContentArea()
	self:_buildNotificationLayer()
	self:_bindToggleKey()

	if IS_MOBILE then
		self:_buildMobileFab()
	end

	return self
end

function NovaUI:_buildScreenGui()
	local existing = PlayerGui:FindFirstChild("NovaUI_ScreenGui")
	if existing then existing:Destroy() end

	self.ScreenGui = new("ScreenGui", {
		Name = "NovaUI_ScreenGui",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100,
		IgnoreGuiInset = true,
		Parent = PlayerGui,
	})
end

function NovaUI:_buildWindow()
	local theme = self.Theme

	self.Main = new("Frame", {
		Name = "Main",
		Size = self.Size,
		Position = UDim2.new(0.5, -self.Size.X.Offset / 2, 0.5, -self.Size.Y.Offset / 2),
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = self.ScreenGui,
	})
	corner(10).Parent = self.Main
	stroke(theme.Stroke, 1).Parent = self.Main

	self.MainScale = new("UIScale", { Scale = 1, Parent = self.Main })
	self:_fitToViewport()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			self:_fitToViewport()
		end)
	end

	local shadow = new("ImageLabel", {
		Name = "Shadow",
		Image = "rbxassetid://1316045217",
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 0.6,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(10, 10, 118, 118),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 40, 1, 40),
		Position = UDim2.new(0.5, 0, 0.5, 4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = -1,
		Parent = self.Main,
	})

	self:_makeDraggable(self.Main)
end

function NovaUI:_fitToViewport()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local viewport = camera.ViewportSize
	if viewport.X <= 0 or viewport.Y <= 0 then return end

	local margin = 24
	local windowWidth = self.Size.X.Offset
	local windowHeight = self.Size.Y.Offset

	local scaleX = (viewport.X - margin) / windowWidth
	local scaleY = (viewport.Y - margin) / windowHeight
	local scale = math.min(1, scaleX, scaleY)

	self.MainScale.Scale = scale
end

function NovaUI:_makeDraggable(frame)
	local dragging, dragStart, startPos = false, nil, nil

	local function update(input)
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end

	self._startDrag = function(input)
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end

	self._updateDrag = function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end

	UserInputService.InputChanged:Connect(function(input)
		self._updateDrag(input)
	end)
end


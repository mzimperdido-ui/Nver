--[[
	Por padrão este arquivo não inclui nenhum asset id de ícone "inventado".
	Ele tenta, nesta ordem:
		1) Um provider customizado setado via NovaUI.SetIconProvider(fn)
		2) Um módulo "Lucide" (latte-soft/lucide-roblox) achado em
		   ReplicatedStorage ou ReplicatedStorage.Packages
		3) Um módulo "FluentIcons" (tabela nome->rbxassetid, estilo Fluent)
		   achado em ReplicatedStorage
		4) Fallback: ícone placeholder quase invisível (não quebra a UI)

	Pra usar a Opção 1 (mais simples com loadstring, sem precisar upar nada
	no Studio), carregue a lib de ícones ANTES e registre assim:

		local Lucide = loadstring(game:HttpGet(
			"https://raw.githubusercontent.com/latte-soft/lucide-roblox/main/lib/init.luau"
		))()
		local NovaUI = loadstring(game:HttpGet("...seu link NovaUI.lua..."))()
		NovaUI.SetIconProvider(function(name, size)
			local asset = Lucide.GetAsset(name, size or 64)
			return asset.Url, asset.ImageRectOffset, asset.ImageRectSize
		end)
]]

local Icons = {}
local _customProvider = nil
local _lucideModule = nil
local _fluentIconsModule = nil
local _searchedForModules = false

local function tryRequire(instance)
	if not instance then return nil end
	local ok, result = pcall(require, instance)
	if ok then return result end
	return nil
end

local function findAutoModules()
	if _searchedForModules then return end
	_searchedForModules = true

	local inRS = ReplicatedStorage:FindFirstChild("Lucide")
	if inRS then _lucideModule = tryRequire(inRS) end

	if not _lucideModule then
		local packages = ReplicatedStorage:FindFirstChild("Packages")
		if packages then
			local pkg = packages:FindFirstChild("Lucide")
			if pkg then _lucideModule = tryRequire(pkg) end
		end
	end

	local fluentIn = ReplicatedStorage:FindFirstChild("FluentIcons")
	if fluentIn then _fluentIconsModule = tryRequire(fluentIn) end
end

function Icons.Get(name, size)
	if _customProvider then
		local ok, url, offset, rectSize = pcall(_customProvider, name, size)
		if ok and url then
			return {
				Image = url,
				ImageRectOffset = offset or Vector2.new(0, 0),
				ImageRectSize = rectSize or Vector2.new(0, 0),
			}
		end
	end

	findAutoModules()

	if _lucideModule then
		local ok, asset = pcall(_lucideModule.GetAsset, name, size or 64)
		if ok and asset then
			return {
				Image = asset.Url,
				ImageRectOffset = asset.ImageRectOffset or Vector2.new(0, 0),
				ImageRectSize = asset.ImageRectSize or Vector2.new(0, 0),
			}
		end
	end

	if _fluentIconsModule then
		local id = _fluentIconsModule["lucide-" .. name] or _fluentIconsModule[name]
		if id then
			return {
				Image = id,
				ImageRectOffset = Vector2.new(0, 0),
				ImageRectSize = Vector2.new(0, 0),
			}
		end
	end

	return {
		Image = "rbxasset://textures/ui/GuiImagePlaceholder.png",
		ImageRectOffset = Vector2.new(0, 0),
		ImageRectSize = Vector2.new(0, 0),
		Missing = true,
	}
end

function Icons.Apply(imageObject, name, size)
	local data = Icons.Get(name, size)
	imageObject.Image = data.Image
	imageObject.ImageRectOffset = data.ImageRectOffset
	imageObject.ImageRectSize = data.ImageRectSize
	if data.Missing then
		imageObject.ImageTransparency = 0.85
	end
	return imageObject
end


--[[
    Ocerium Controller
    ------------------
    Camada de lógica para a UI "Ocerium_Library.lua".
    O arquivo original só DESENHA a interface (Instance.new em cascata),
    ele não conecta nenhum evento. Este script:

      1. Carrega a lib visual (loadstring do arquivo cru)
      2. Localiza os elementos por Name (não por índice G2L, que muda a cada geração)
      3. Conecta os eventos essenciais: fechar, minimizar, criar abas, criar botões e toggles

    USO:
        local UILib = loadstring(readfile("Ocerium_Controller.lua"))()

        local Window = UILib:Init()

        local tab = Window:CreateTab("Home", "rbxassetid://115901920112418")

        tab:CreateButton({
            Title = "Farm Auto",
            Desc  = "Ativa o autofarm",
            Callback = function()
                print("Botão clicado!")
            end
        })

        tab:CreateToggle({
            Title = "ESP",
            Desc  = "Mostra os jogadores através de paredes",
            Default = false,
            Callback = function(state)
                print("Toggle:", state)
            end
        })
]]

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Library = {}
Library.__index = Library

-- ============================================================
-- Utilitários
-- ============================================================

-- Acha o primeiro descendente com esse Name (a lib original não
-- tem caminho fixo confiável fora dos índices G2L, então buscamos por nome)
local function find(parent, name)
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj.Name == name then
            return obj
        end
    end
    return nil
end

-- Acha o primeiro FILHO direto com esse Name
local function child(parent, name)
    return parent:FindFirstChild(name)
end

local function tween(obj, props, time, style, direction)
    local info = TweenInfo.new(
        time or 0.25,
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

-- Conecta o botão "interact" (filho direto) de um elemento, com debounce
local function onClick(element, callback)
    local interact = element:FindFirstChild("interact")
        or element:FindFirstChild("Interact")
    if not interact then
        warn("[Ocerium] 'interact' não encontrado em: " .. element:GetFullName())
        return
    end

    local debounce = false
    interact.MouseButton1Click:Connect(function()
        if debounce then return end
        debounce = true
        local ok, err = pcall(callback)
        if not ok then
            warn("[Ocerium] erro no callback de " .. element.Name .. ": " .. tostring(err))
        end
        task.wait(0.15)
        debounce = false
    end)

    return interact
end

-- ============================================================
-- Init: monta a UI e conecta os controles fixos (topo/abas/resize)
-- ============================================================

function Library:Init(sourceCode)
    local self = setmetatable({}, Library)

    -- A lib original faz: return G2L["1"], require
    -- G2L["1"] é a ScreenGui já parentada em PlayerGui.
    local ScreenGui, _require = loadstring(sourceCode)()
    self.ScreenGui = ScreenGui

    self.Main      = find(ScreenGui, "main")
    self.Top       = child(self.Main, "top")
    self.Tabs      = child(self.Main, "tabs")
    self.TabList   = find(self.Tabs, "tab")          -- ScrollingFrame que guarda os botões de aba
    self.Pages     = child(self.Main, "pages")
    self.PageTemplate = find(self.Pages, "page")     -- ScrollingFrame "page" (conteúdo de uma aba)
    self.Resize    = find(self.Main, "resize")
    self.MiniHome  = find(ScreenGui, "minihome")

    self.Tabs_ByName = {}
    self.Open = true
    self.Minimized = false

    -- --------------------------------------------------------
    -- Guarda os templates originais (botão de aba, Button, Toggle)
    -- e depois os REMOVE da UI viva, porque eles vieram como
    -- "exemplo" já visível dentro da página.
    -- --------------------------------------------------------
    local tabBtnTemplate = find(self.Tabs, "btn")
    self.TabBtnTemplate = tabBtnTemplate:Clone()
    tabBtnTemplate:Destroy()

    local buttonTemplate = self.PageTemplate:FindFirstChild("Button")
    if buttonTemplate then
        self.ButtonTemplate = buttonTemplate:Clone()
        buttonTemplate:Destroy()
    end

    local toggleTemplate = self.PageTemplate:FindFirstChild("Toggle")
    if toggleTemplate then
        self.ToggleTemplate = toggleTemplate:Clone()
        toggleTemplate:Destroy()
    end

    -- remove a versão de exemplo "Toggle(enabled)" se existir
    local toggleEnabledExample = self.PageTemplate:FindFirstChild("Toggle(enabled)")
    if toggleEnabledExample then
        toggleEnabledExample:Destroy()
    end

    -- O "page" template original também vira o template de conteúdo de aba;
    -- clona ele vazio (sem os filhos que restaram) para reaproveitar por aba.
    self.PageContainer = self.Pages -- onde as "page" (uma por aba) ficam dentro

    -- --------------------------------------------------------
    -- Botões do topo: close / mini
    -- --------------------------------------------------------
    local functions = child(self.Top, "functions")
    local closeBtn = child(functions, "close")
    local miniBtn  = child(functions, "mini")

    if closeBtn then
        onClick(closeBtn, function()
            self:Toggle(false)
        end)
    end

    if miniBtn then
        onClick(miniBtn, function()
            self:Minimize(true)
        end)
    end

    -- abrir de novo a partir do "minihome" (botão flutuante quando minimizado)
    if self.MiniHome then
        local openBtn = find(self.MiniHome, "open")
        if openBtn then
            local quickfunc = openBtn:FindFirstChild("quickfunc")
            if quickfunc then
                onClick(quickfunc, function()
                    self:Minimize(false)
                end)
            end
        end
        self.MiniHome.Visible = false
    end

    -- --------------------------------------------------------
    -- Resize (arrastar para redimensionar) - opcional, básico
    -- --------------------------------------------------------
    if self.Resize then
        local dragging = false
        self.Resize.MouseButton1Down:Connect(function()
            dragging = true
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local newSize = self.Main.Size + UDim2.new(0, input.Delta.X, 0, input.Delta.Y)
                self.Main.Size = UDim2.new(
                    0, math.max(400, newSize.X.Offset),
                    0, math.max(300, newSize.Y.Offset)
                )
            end
        end)
    end

    -- --------------------------------------------------------
    -- Arrastar a janela pela barra do topo
    -- --------------------------------------------------------
    do
        local dragging = false
        local dragStart, startPos

        self.Top.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = self.Main.Position
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                self.Main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    return self
end

-- ============================================================
-- Abrir / Fechar / Minimizar
-- ============================================================

function Library:Toggle(state)
    self.Open = state
    if state then
        self.Main.Visible = true
        self.Main.Size = UDim2.new(0, 0, 0, 0)
        tween(self.Main, {Size = UDim2.new(0, 700, 0, 560)}, 0.3)
    else
        local t = tween(self.Main, {Size = UDim2.new(0, 0, 0, 0)}, 0.25)
        t.Completed:Connect(function()
            if not self.Open then
                self.Main.Visible = false
            end
        end)
    end
end

function Library:Minimize(state)
    self.Minimized = state
    self.Main.Visible = not state
    if self.MiniHome then
        self.MiniHome.Visible = state
    end
end

-- ============================================================
-- Abas
-- ============================================================

function Library:CreateTab(name, icon)
    local tabObj = {}

    -- Botão da aba (clone do template)
    local btn = self.TabBtnTemplate:Clone()
    btn.Name = name
    local title = btn:FindFirstChild("title")
    if title then title.Text = name end

    local iconFrame = btn:FindFirstChild("icon")
    if iconFrame then
        local img = iconFrame:FindFirstChildOfClass("ImageLabel")
        if img and icon then
            img.Image = icon
        end
    end
    btn.Parent = self.TabList

    -- Página de conteúdo (clone do template de página, vazio)
    local page
    if not self._firstPageUsed then
        -- primeira aba reaproveita o "page" original (já está no lugar certo)
        page = self.PageTemplate
        self._firstPageUsed = true
    else
        page = self.PageTemplate:Clone()
        page.Parent = self.PageContainer
    end
    page.Name = name
    page.Visible = false

    tabObj.Page = page
    tabObj.Button = btn

    -- Seleciona essa aba ao clicar
    onClick(btn, function()
        self:SelectTab(name)
    end)

    self.Tabs_ByName[name] = tabObj

    -- Se for a primeira aba criada, seleciona automaticamente
    if not self.ActiveTab then
        self:SelectTab(name)
    end

    -- --------------------------------------------------------
    -- API do objeto "tab" retornado
    -- --------------------------------------------------------
    local api = {}

    function api:CreateButton(opts)
        opts = opts or {}
        local btnFrame = self.Library.ButtonTemplate:Clone()
        btnFrame.Parent = page

        local titleLbl = btnFrame:FindFirstChild("title")
        if titleLbl then titleLbl.Text = opts.Title or "Button" end

        local descLbl = btnFrame:FindFirstChild("desc")
        if descLbl then
            if opts.Desc then
                descLbl.Text = opts.Desc
                descLbl.Visible = true
            else
                descLbl.Visible = false
            end
        end

        onClick(btnFrame, function()
            if opts.Callback then opts.Callback() end
        end)

        return btnFrame
    end

    function api:CreateToggle(opts)
        opts = opts or {}
        local togFrame = self.Library.ToggleTemplate:Clone()
        togFrame.Parent = page

        local titleLbl = togFrame:FindFirstChild("title")
        if titleLbl then titleLbl.Text = opts.Title or "Toggle" end

        local descLbl = togFrame:FindFirstChild("desc")
        if descLbl then
            if opts.Desc then
                descLbl.Text = opts.Desc
                descLbl.Visible = true
            else
                descLbl.Visible = false
            end
        end

        local tog = togFrame:FindFirstChild("tog")
        local check = tog and tog:FindFirstChild("check")
        local glow = tog and tog:FindFirstChild("glow")

        local state = opts.Default or false

        local function render(instant)
            local goalBg = state and Color3.fromRGB(91, 204, 255) or Color3.fromRGB(29, 29, 29)
            local goalCheckTr = state and 0 or 1
            local goalGlowTr = state and 0.7 or 1

            if instant then
                if tog then tog.BackgroundColor3 = goalBg end
                if check then check.ImageTransparency = goalCheckTr end
                if glow then glow.ImageTransparency = goalGlowTr end
            else
                if tog then tween(tog, {BackgroundColor3 = goalBg}, 0.2) end
                if check then tween(check, {ImageTransparency = goalCheckTr}, 0.2) end
                if glow then tween(glow, {ImageTransparency = goalGlowTr}, 0.2) end
            end
        end

        render(true)

        onClick(togFrame, function()
            state = not state
            render(false)
            if opts.Callback then opts.Callback(state) end
        end)

        return {
            Frame = togFrame,
            Set = function(_, newState)
                state = newState
                render(false)
                if opts.Callback then opts.Callback(state) end
            end,
            Get = function()
                return state
            end,
        }
    end

    api.Library = self
    return api
end

function Library:SelectTab(name)
    for tabName, tabObj in pairs(self.Tabs_ByName) do
        local isActive = tabName == name
        tabObj.Page.Visible = isActive

        local indicator = tabObj.Button:FindFirstChild("indicator")
        if indicator then
            tween(indicator, {BackgroundTransparency = isActive and 0 or 1}, 0.2)
        end

        local titleLbl = tabObj.Button:FindFirstChild("title")
        if titleLbl then
            tween(titleLbl, {TextTransparency = isActive and 0 or 0.4}, 0.2)
        end
    end
    self.ActiveTab = name
end

return Library
